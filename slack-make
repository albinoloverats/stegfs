#!/bin/sh

app=stegfs
version=2015.08.1
pkgdir=build

if ! pkg-config --exists cmocka; then
	echo "CMocka development files are required to run the test suite" >&2
	exit 1
fi

make -f Makefile
make -f Makefile test || exit $?
mkdir -p ${pkgdir}/usr/{bin,share/man/man1}
make -f Makefile install PREFIX=${pkgdir}

mkdir ${pkgdir}/install
cp slack-desc ${pkgdir}/install

cd  ${pkgdir}
makepkg -l y -c n ../${app}-${version}-x86_64-1aa.tgz
